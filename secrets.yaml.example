# ============================================================
#  Secrets — copier ce fichier en secrets.yaml
#  puis remplacer les valeurs par les vraies credentials.
#
#  secrets.yaml est ignoré par Git. Ne jamais le committer.
#  Générer api_encryption_key : esphome dashboard secret
# ============================================================

wifi_ssid: "Votre_SSID"
wifi_password: "Votre_Mot_de_Passe"
fallback_password: "Mot_de_Passe_AP"

# Clé de chiffrement de l'API ESPHome (base64, 32 octets)
api_encryption_key: "Generer_avec_esphome_dashboard_secret"

# Mot de passe OTA
ota_password: "Votre_Mot_de_Passe_OTA"

# Optionnel : serveur web (décommenter le bloc web_server dans anenji.yaml)
# web_server_username: "admin"
# web_server_password: "Votre_Mot_de_Passe_Web"
