          "port": "Port",
          "serial_device": "Serial port",
          "agent_device_id": "Provider device ID",
          "eybond_devaddr": "RS485 device address",
          "eybond_broadcast": "Broadcast address",
          "eybond_announce_ip": "Announce IP",
          "update_interval": "Update interval (seconds)",
          "strict_crc": "Strict CRC validation",
          "debug_panel": "Show debug panel in sidebar"
