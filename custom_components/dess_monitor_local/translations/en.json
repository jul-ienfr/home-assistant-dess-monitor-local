          "serial_device": "USB / RS232 device path. You can also type a path manually.",
          "agent_device_id": "providerDeviceId of the inverter exposed by solar-system-agent.",
          "eybond_devaddr": "RS485 slave address behind the EyBond dongle.",
          "eybond_broadcast": "UDP broadcast target used to announce the local server to the dongle.",
