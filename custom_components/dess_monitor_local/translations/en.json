      "init": {
        "title": "EyBond options",
        "menu_options": {
          "devices": "Manage discovered devices",
          "rescan": "Scan for new dongles",
          "listener": "Listener settings",
          "edit": "Edit connection",
          "migrate_hub": "Convert to EyBond hub",
          "debug_panel": "Debug panel"
        }
      },
      "rescan": {
        "title": "Scan for new dongles",
        "description": "Broadcasts the discovery beacon for about a minute so new EyBond dongles on the network attach and get discovered. Already-connected dongles may briefly reconnect during the scan (the beacon can't target a single dongle). Submit to start."
      },
      "migrate_hub": {
        "title": "Convert to EyBond hub",
        "description": "This converts the single-device entry into an EyBond hub: one listener that auto-discovers dongles by serial number (PN) and lets you add more later. The currently connected dongle becomes a configured child with its current protocol and address. Entity history is preserved. The dongle must be online now so its PN can be captured. Submit to convert and reload."
      },
      "devices": {
        "title": "Configure discovered devices",
        "description": "Configure all discovered dongles here and submit once. Fields are grouped per dongle by serial number (PN): enable it, name it, choose a protocol ('none' = discovered but not polled), set the RS485 address (1 unless daisy-chained), or tick remove to forget it. Applying does NOT reload the hub — your connected dongles stay online.\n\nDiscovered:\n{devices}"
      },
      "listener": {
        "title": "Listener settings",
        "description": "Change the TCP listener and polling interval. Saving reloads the hub.",
        "data": {
          "host": "Bind interface",
          "port": "Listen port",
          "eybond_broadcast": "Broadcast address",
          "eybond_announce_ip": "Announce IP",
          "update_interval": "Update interval (seconds)"
